{
  "description": "Configuration des remplacements d'assets FontAwesome pour la migration",
  "version": "5-to-6",
  "replacements": {
    "stylesheets": {
      "free": {
        "cdn_urls": {
          "/font-awesome\\/(\\d+)\\./": "font-awesome/{target_version}.",
          "/\\/font-awesome\\/(\\d+)\\./": "/font-awesome/{target_version}.",
          "/https:\\/\\/use\\.fontawesome\\.com\\/releases\\/v(\\d+)\\./": "https://use.fontawesome.com/releases/v{target_version}.",
          "/https:\\/\\/cdnjs\\.cloudflare\\.com\\/ajax\\/libs\\/font-awesome\\/(\\d+)\\./": "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/{target_version}.",
          "/https:\\/\\/cdn\\.jsdelivr\\.net\\/npm\\/@fortawesome\\/fontawesome-free@(\\d+)\\./": "https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@{target_version}.",
          "/https:\\/\\/maxcdn\\.bootstrapcdn\\.com\\/font-awesome\\/(\\d+)\\./": "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/{target_version}."
        },
        "local_paths": {
          "/\\/fontawesome-free-(\\d+)\\./": "/fontawesome-free-{target_version}.",
          "/\\/font-awesome-(\\d+)\\./": "/font-awesome-{target_version}.",
          "/node_modules\\/@fortawesome\\/fontawesome-free-(\\d+)\\./": "node_modules/@fortawesome/fontawesome-free/"
        }
      },
      "pro": {
        "cdn_urls": {
          "/https:\\/\\/pro\\.fontawesome\\.com\\/releases\\/v(\\d+)\\./": "https://pro.fontawesome.com/releases/v{target_version}."
        },
        "local_paths": {
          "/node_modules\\/@fortawesome\\/fontawesome-pro-(\\d+)\\./": "node_modules/@fortawesome/fontawesome-pro/",
          "/\\/fontawesome-pro-(\\d+)\\./": "/fontawesome-pro-{target_version}."
        }
      }
    },
    "javascript": {
      "free": {
        "es6_imports": {
          "from \"@fortawesome/fontawesome-free-solid\"": "from \"@fortawesome/free-solid-svg-icons\"",
          "from \"@fortawesome/fontawesome-free-regular\"": "from \"@fortawesome/free-regular-svg-icons\"",
          "from \"@fortawesome/fontawesome-free-brands\"": "from \"@fortawesome/free-brands-svg-icons\""
        },
        "dynamic_imports": {
          "import(\"@fortawesome/fontawesome-free-solid\")": "import(\"@fortawesome/free-solid-svg-icons\")",
          "import(\"@fortawesome/fontawesome-free-regular\")": "import(\"@fortawesome/free-regular-svg-icons\")",
          "import(\"@fortawesome/fontawesome-free-brands\")": "import(\"@fortawesome/free-brands-svg-icons\")"
        },
        "commonjs": {
          "require(\"@fortawesome/fontawesome-free-solid\")": "require(\"@fortawesome/free-solid-svg-icons\")",
          "require(\"@fortawesome/fontawesome-free-regular\")": "require(\"@fortawesome/free-regular-svg-icons\")",
          "require(\"@fortawesome/fontawesome-free-brands\")": "require(\"@fortawesome/free-brands-svg-icons\")"
        },
        "cdn_urls": {
          "/https:\\/\\/use\\.fontawesome\\.com\\/releases\\/v(\\d+)\\./": "https://use.fontawesome.com/releases/v{target_version}."
        }
      },
      "pro": {
        "es6_imports": {
          "from \"@fortawesome/fontawesome-pro-solid\"": "from \"@fortawesome/pro-solid-svg-icons\"",
          "from \"@fortawesome/fontawesome-pro-regular\"": "from \"@fortawesome/pro-regular-svg-icons\"",
          "from \"@fortawesome/fontawesome-pro-light\"": "from \"@fortawesome/pro-light-svg-icons\"",
          "from \"@fortawesome/fontawesome-pro-duotone\"": "from \"@fortawesome/pro-duotone-svg-icons\"",
          "from \"@fortawesome/fontawesome-pro-thin\"": "from \"@fortawesome/pro-thin-svg-icons\"",
          "from \"@fortawesome/fontawesome-pro-brands\"": "from \"@fortawesome/free-brands-svg-icons\""
        },
        "dynamic_imports": {
          "import(\"@fortawesome/fontawesome-pro-solid\")": "import(\"@fortawesome/pro-solid-svg-icons\")",
          "import(\"@fortawesome/fontawesome-pro-regular\")": "import(\"@fortawesome/pro-regular-svg-icons\")",
          "import(\"@fortawesome/fontawesome-pro-light\")": "import(\"@fortawesome/pro-light-svg-icons\")",
          "import(\"@fortawesome/fontawesome-pro-duotone\")": "import(\"@fortawesome/pro-duotone-svg-icons\")",
          "import(\"@fortawesome/fontawesome-pro-thin\")": "import(\"@fortawesome/pro-thin-svg-icons\")"
        },
        "commonjs": {
          "require(\"@fortawesome/fontawesome-pro-solid\")": "require(\"@fortawesome/pro-solid-svg-icons\")",
          "require(\"@fortawesome/fontawesome-pro-regular\")": "require(\"@fortawesome/pro-regular-svg-icons\")",
          "require(\"@fortawesome/fontawesome-pro-light\")": "require(\"@fortawesome/pro-light-svg-icons\")",
          "require(\"@fortawesome/fontawesome-pro-duotone\")": "require(\"@fortawesome/pro-duotone-svg-icons\")",
          "require(\"@fortawesome/fontawesome-pro-thin\")": "require(\"@fortawesome/pro-thin-svg-icons\")"
        }
      }
    },
    "html": {
      "free": {
        "cdn_links": {
          "/href=\"https:\\/\\/use\\.fontawesome\\.com\\/releases\\/v(\\d+)\\./": "href=\"https://use.fontawesome.com/releases/v{target_version}.",
          "/href=\"https:\\/\\/cdnjs\\.cloudflare\\.com\\/ajax\\/libs\\/font-awesome\\/(\\d+)\\./": "href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/{target_version}.",
          "/src=\"https:\\/\\/use\\.fontawesome\\.com\\/releases\\/v(\\d+)\\./": "src=\"https://use.fontawesome.com/releases/v{target_version}."
        },
        "local_paths": {
          "/href=\"\\/fontawesome-free-(\\d+)\\./": "href=\"/fontawesome-free-{target_version}.",
          "/src=\"\\/fontawesome-free-(\\d+)\\./": "src=\"/fontawesome-free-{target_version}."
        }
      },
      "pro": {
        "cdn_links": {
          "/href=\"https:\\/\\/pro\\.fontawesome\\.com\\/releases\\/v(\\d+)\\./": "href=\"https://pro.fontawesome.com/releases/v{target_version}.",
          "/src=\"https:\\/\\/pro\\.fontawesome\\.com\\/releases\\/v(\\d+)\\./": "src=\"https://pro.fontawesome.com/releases/v{target_version}."
        },
        "local_paths": {
          "/href=\"\\/fontawesome-pro-(\\d+)\\./": "href=\"/fontawesome-pro-{target_version}.",
          "/src=\"\\/fontawesome-pro-(\\d+)\\./": "src=\"/fontawesome-pro-{target_version}."
        }
      }
    },
    "package_json": {
      "dependencies": {
        "/\"@fortawesome\\/fontawesome-free\":\\s*\"[\\^~]?(\\d+)\\.[^\"]*\"/": "\"@fortawesome/fontawesome-free\": \"^{target_version}.0.0\"",
        "/\"@fortawesome\\/fontawesome-pro\":\\s*\"[\\^~]?(\\d+)\\.[^\"]*\"/": "\"@fortawesome/fontawesome-pro\": \"^{target_version}.0.0\"",
        "/\"@fortawesome\\/fontawesome-svg-core\":\\s*\"[\\^~]?(\\d+)\\.[^\"]*\"/": "\"@fortawesome/fontawesome-svg-core\": \"^{target_version}.0.0\""
      }
    }
  },
  "excluded_patterns": [
    "https://kit.fontawesome.com/",
    "@import \"~@fortawesome/fontawesome-free/scss/fontawesome\";",
    "@import \"~@fortawesome/fontawesome-free/scss/solid\";",
    "@import \"~@fortawesome/fontawesome-free/scss/regular\";",
    "@import \"~@fortawesome/fontawesome-free/scss/brands\";",
    "from \"@fortawesome/fontawesome-free/js/all\"",
    "from \"@fortawesome/fontawesome-free/js/fontawesome\"",
    "@fortawesome/fontawesome-free/js/brands.js",
    "@fortawesome/fontawesome-free/js/solid.js",
    "@fortawesome/fontawesome-free/js/regular.js",
    "@fortawesome/fontawesome-free/js/fontawesome.js"
  ],
  "notes": {
    "excluded_patterns": "Ces patterns sont exclus car ils restent identiques entre FA5 et FA6",
    "kit_urls": "Les URLs de kit FontAwesome ne changent pas",
    "scss_imports": "Les imports SCSS restent identiques en FA6"
  }
}